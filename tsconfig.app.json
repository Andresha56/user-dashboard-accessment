{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
     "paths": {
      "@queries": ["./src/queries/index"],
      "@queries/*": ["./src/queries/*"],
      "@components": ["./src/components/index"],
      "@components/*": ["./src/components/*"],
      "@pages": ["./src/pages/index"],
      "@pages/*": ["./src/pages/*"],
      "@services": ["./src/services/index"],
      "@services/*": ["./src/services/*"],
      "@context": ["./src/context/index"],
      "@context/*": ["./src/context/*"],
      "@archetypes": ["./src/archetypes/index"],
      "@archetypes/*": ["./src/archetypes/*"],
      "@hooks": ["./src/hooks/index"],
      "@hooks/*": ["./src/hooks/*"],
      "@icons": ["./src/icons/index"],
      "@icons/*": ["./src/icons/*"],
      "@constant": ["./src/constant/index"],
      "@constant/*": ["./src/constant/*"],
      "@schema": ["./src/schema/index"],
      "@schema/*": ["./src/schema/*"],
      "@dialog": ["./src/dialog/index"],
      "@dialog/*": ["./src/dialog/*"]
    },
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
